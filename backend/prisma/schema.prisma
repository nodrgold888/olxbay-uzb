generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  phone         String?
  password      String
  city          String?
  createdAt     DateTime  @default(now())
  listings      Listing[]
  ordersBought  Order[]   @relation("BuyerOrders")
  ordersSold    Order[]   @relation("SellerOrders")
  conversationsAsBuyer  Conversation[] @relation("ConversationBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationSeller")
  messages              Message[]
  favorites             Favorite[]
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  nameUz   String
  slug     String     @unique
  listings Listing[]

  parent     Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  parentId   Int?
  children   Category[] @relation("CategoryChildren")
}

model Listing {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  price       Float
  currency    String   @default("UZS")
  city        String
  imageUrl    String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller     User     @relation(fields: [sellerId], references: [id])
  sellerId   Int
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  orders     Order[]
  conversations Conversation[]
  favorites  Favorite[]
}

// Avito-style "save for later" — a many-to-many between users and listings.
model Favorite {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id])
  userId    Int
  listing   Listing @relation(fields: [listingId], references: [id])
  listingId Int

  @@unique([userId, listingId])
}

// Escrow flow: PENDING_PAYMENT -> PAID_ESCROW -> SHIPPED -> RELEASED
// A buyer can DISPUTE from PAID_ESCROW or SHIPPED; a dispute is resolved
// manually (REFUNDED back to buyer or RELEASED to seller) by an admin/support
// process outside this MVP.
model Order {
  id          Int      @id @default(autoincrement())
  status      String   @default("PENDING_PAYMENT")
  amount      Float
  currency    String   @default("UZS")
  createdAt   DateTime @default(now())
  paidAt      DateTime?
  shippedAt   DateTime?
  releasedAt  DateTime?

  listing    Listing @relation(fields: [listingId], references: [id])
  listingId  Int
  buyer      User    @relation("BuyerOrders", fields: [buyerId], references: [id])
  buyerId    Int
  seller     User    @relation("SellerOrders", fields: [sellerId], references: [id])
  sellerId   Int
}

// A DM thread scoped to one listing between its seller and one prospective
// buyer — a buyer can message a seller directly from a listing page, before
// any purchase happens (not tied to an Order).
model Conversation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  listing   Listing @relation(fields: [listingId], references: [id])
  listingId Int
  buyer     User    @relation("ConversationBuyer", fields: [buyerId], references: [id])
  buyerId   Int
  seller    User    @relation("ConversationSeller", fields: [sellerId], references: [id])
  sellerId  Int

  messages  Message[]

  @@unique([listingId, buyerId, sellerId])
}

model Message {
  id             Int      @id @default(autoincrement())
  body           String
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId Int
  sender         User         @relation(fields: [senderId], references: [id])
  senderId       Int
}
